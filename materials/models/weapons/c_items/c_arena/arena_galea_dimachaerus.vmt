"VertexLitGeneric"
{
	"$basetexture"			"models/weapons/c_items/c_arena/arena_galea_dimachaerus"
	"$bumpmap"				"models/weapons/c_items/c_arena/arena_galea_dimachaerus_n"
	"$bumpmapalphaphongmask"	"1"
	"$phong"				"1"
	"$phongexponenttexture"	"models/weapons/c_items/c_arena/arena_galea_dimachaerus_exp"
	"$phongalbedotint"		"1"
	"$phongboost"			"7.0"
	"$phongfresnelranges"	"[.3 .65 1]"
	"$lightwarptexture"		"models/player/pyro/pyro_lightwarp"
	"$rimlight"				"1"
	"$rimlightexponent"		"4"
	"$rimlightboost"		"1.2"
	"$rimmask"				"1"
	"$halflambert"			"1"
	"$detail"				"effects/tiledfire/fireLayeredSlowTiled512"
	"$detailscale"			"5"
	"$detailblendfactor"	"0"
	"$detailblendmode"		"6"
	"$yellow"				"0"
	"$cloakPassEnabled"		"1"
	"Proxies"
	{
		"invis"		{ }
		"AnimatedTexture"	{ "animatedtexturevar" "$detail" "animatedtextureframenumvar" "$detailframe" "animatedtextureframerate" 30 }
		"BurnLevel"	{ "resultVar" "$detailblendfactor" }
		"YellowLevel"	{ "resultVar" "$yellow" }
		"Equals"	{ "srcVar1" "$yellow" "resultVar" "$color2" }
	}
}
