"LightmappedGeneric"
{
	"$basetexture" "lekplats/sno_egen"
	"$bumpmap" "lekplats/sno_egen_normal"
	"$color" "[0.52 0.56 0.64]"
	"$envmap" "env_cubemap"
	"$envmaptint" "[0.05 0.055 0.065]"
	"$basetexturetransform" "center 0 0 scale 0.5 0.5 rotate 0 translate 0 0"
	"$bumptransform" "center 0 0 scale 0.5 0.5 rotate 0 translate 0 0"
	"$surfaceprop" "ice"
	"%keywords" "tf"
}
